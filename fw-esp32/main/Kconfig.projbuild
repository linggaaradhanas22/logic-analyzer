menu "Logic analyzer gateway"

    config LA_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        help
            Station SSID the gateway associates with. Leave empty only for a
            link-only bring-up run. The value is stored in the generated,
            git-ignored build/esp32/sdkconfig, never in tracked sources.

    config LA_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            Station password. Empty selects an open network.

    config LA_LINK_BAUD
        int "UART2 analyzer link baud rate"
        default 921600
        help
            Link rate to the Zynq analyzer. P5.5 runs the loopback gate at
            921600 first and then at 2000000; the value lives in the generated,
            git-ignored build/esp32/sdkconfig.

endmenu
