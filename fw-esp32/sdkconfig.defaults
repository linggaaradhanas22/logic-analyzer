# P5.1 pinned gateway configuration. Credentials are never stored here; set
# them through `idf.py -B build/esp32 menuconfig` into the ignored sdkconfig.

# P9.1 (2026-09-17): the gateway is an ESP32-S3-DevKitC-1 with an
# ESP32-S3-WROOM-1-N16R8 module (16 MB flash, 8 MB octal PSRAM).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# The gateway app outgrew the 1 MiB default factory partition once TinyUSB and
# the web UI were linked; the large single-app table gives it 1500K.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Console stays on UART0 (the CP2102 "UART" port) so the native USB port is
# free for the P9.1 CDC host transport. The default S3 secondary console
# (USB-Serial-JTAG) shares the native USB pins with TinyUSB, so it is off.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 1 kHz FreeRTOS tick (docs/plan.md P1.6).
CONFIG_FREERTOS_HZ=1000

# Runtime statistics for the P5.4 UiTask / P8 measurements.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Task watchdog: LinkRx, LinkTx, NetServer and UiTask subscribe themselves.
# Panic mode makes a hung watched task reset the gateway instead of only
# logging (P8.4 requires a reset).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# lwIP windows for the TCP relay. P8.2 tuning 2026-09-11: the 64 KiB
# link_to_net ring is the stall absorber; 32 KiB windows exhausted the heap
# during live streaming (3.5 KB free, silent drops, stale client), so the
# windows stay at 16 KiB.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384

CONFIG_MDNS_MAX_SERVICES=4

# P10.1 live web view: the WebSocket endpoint at /ws needs the httpd WS
# support compiled in (the APIs and the is_websocket handler field are gated).
CONFIG_HTTPD_WS_SUPPORT=y

# P9.1 USB CDC host transport (espressif/esp_tinyusb). The endpoint buffer is
# the USB wMaxPacketSize: a full-speed device is limited to 64 bytes, so the
# component's "set to 8192 for best performance" advice does not apply to the
# FS-only ESP32-S3. An 8192 endpoint makes Windows enumerate the device but
# fail to configure the port ("device does not recognize the command" /
# "device attached to the system is not functioning"). The FIFOs stay larger;
# the component help requires RX >= the endpoint size.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_EP_BUFSIZE=64
CONFIG_TINYUSB_DESC_PRODUCT_STRING="RTOS logic analyzer gateway"
CONFIG_TINYUSB_DESC_CDC_STRING="LA gateway CDC"
CONFIG_TINYUSB_DESC_SERIAL_STRING="la-gw-s3-01"
