      <mxCell id="n25" value="Safety rules: all I/O is 3.3 V LVCMOS33; never apply 5 V to JC, JE, JD or JA. The ESP32 is powered from its own USB and only signal ground is shared. JC inputs use impedance-matched pairs single-ended; keep leads short." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1460" height="80" as="geometry"/></mxCell>
