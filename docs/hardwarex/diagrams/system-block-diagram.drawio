      <mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="n27" value="completed BDs + lengths" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="n28" value="non-cached reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="370"/></Array></mxGeometry></mxCell>
      <mxCell id="n29" value="TxJob (handle + words)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="n30" value="buffer released" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;endFill=1;fontSize=10;dashed=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="625"/><mxPoint x="1020" y="652"/></Array></mxGeometry></mxCell>
      <mxCell id="n31" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="210" width="26" height="26" as="geometry"/></mxCell>
      <mxCell id="n32" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="450" width="26" height="26" as="geometry"/></mxCell>
      <mxCell id="n33" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="780" width="26" height="26" as="geometry"/></mxCell>
      <mxCell id="n34" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="420" width="26" height="26" as="geometry"/></mxCell>
      <mxCell id="n35" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="600" width="26" height="26" as="geometry"/></mxCell>
      <mxCell id="n36" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="780" width="26" height="26" as="geometry"/></mxCell>
      <mxCell id="n37" value="1  Driver builds a finite ordinary SG chain in the descriptor pool." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="n38" value="2  AcqTask programs capture registers and arms; the DMA writes completed AXI-stream packets into the chain." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="915" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="n39" value="3  Each completed BD raises the S2MM interrupt; the ISR acknowledges and notifies AcqTask." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="n40" value="4  AcqTask collects every completed descriptor and the actual received lengths, including short final BDs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="985" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="n41" value="5  The capture becomes a TxJob owned by TxTask; only after transmission does the buffer become reusable." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="n42" value="6  Abort or timeout stops the transfer, soft-resets the datapath and rebuilds the chain before the next capture." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1055" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="n43" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=11;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1400" y="750" width="560" height="202" as="geometry"/></mxCell>
      <mxCell id="n44" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="n43"><mxGeometry x="12" y="32" width="30" height="16" as="geometry"/></mxCell>
      <mxCell id="n45" value="FPGA fabric (PL logic)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="n43"><mxGeometry x="52" y="30" width="500" height="20" as="geometry"/></mxCell>
      <mxCell id="n46" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="n43"><mxGeometry x="12" y="56" width="30" height="16" as="geometry"/></mxCell>
      <mxCell id="n47" value="Control and configuration" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="n43"><mxGeometry x="52" y="54" width="500" height="20" as="geometry"/></mxCell>
      <mxCell id="n48" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n43"><mxGeometry x="12" y="80" width="30" height="16" as="geometry"/></mxCell>
      <mxCell id="n49" value="Processor firmware" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="n43"><mxGeometry x="52" y="78" width="500" height="20" as="geometry"/></mxCell>
      <mxCell id="n50" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="n43"><mxGeometry x="12" y="104" width="30" height="16" as="geometry"/></mxCell>
      <mxCell id="n51" value="Board, wiring and transports" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="n43"><mxGeometry x="52" y="102" width="500" height="20" as="geometry"/></mxCell>
      <mxCell id="n52" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="n43"><mxGeometry x="12" y="128" width="30" height="16" as="geometry"/></mxCell>
      <mxCell id="n53" value="Memory and buffers" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="n43"><mxGeometry x="52" y="126" width="500" height="20" as="geometry"/></mxCell>
      <mxCell id="n54" value="" style="edgeStyle=none;html=1;endArrow=block;endSize=8;strokeWidth=2;dashed=0;" edge="1" parent="n43"><mxGeometry relative="1" as="geometry"><mxPoint x="12" y="158" as="sourcePoint"/><mxPoint x="42" y="158" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="n55" value="data path" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="n43"><mxGeometry x="52" y="150" width="500" height="20" as="geometry"/></mxCell>
      <mxCell id="n56" value="" style="edgeStyle=none;html=1;endArrow=block;endSize=8;strokeWidth=2;dashed=1;" edge="1" parent="n43"><mxGeometry relative="1" as="geometry"><mxPoint x="12" y="182" as="sourcePoint"/><mxPoint x="42" y="182" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="n57" value="buffer release" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="n43"><mxGeometry x="52" y="174" width="500" height="20" as="geometry"/></mxCell>
